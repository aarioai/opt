#!/bin/bash
set -euo pipefail

# https://github.com/aarioai/opt
. /opt/k8s/lib/k3s-lib.sh

g_workdir=$(pwd)
readonly g_workdir
readonly g_up_yaml="$g_workdir/$K8S_UP_YAML"

g_fn=$(basename "$0")

readonly help="
[.]=[options] <repo>=<repository:[tag]>  <image>=<image id>  <container>=<container id>

$g_fn <command> [.]
  -h|h            Show tidy help
  --help|help     Show detailed help

  attach, commit, compose, container prune, cp, diff, export, exec, healthcheck, history,
  image inspect, image prune, images, kill, login, logout, logs, network, pause, pull, push,
  rename, restart, rm, rmi, save, start, stats, stop, system prune, tag, top, unpause, update, volume, wait


  curl
  down [-a]     down current (delete)
    -a:         down with all tls secrets
  logs [container|pod]
  ns|nsenter
  up
  upd|update    update current (down and up)
  pull
  purge
  restart
  run
  status
  tls [command]
    all:        list all tls secrets
    up:
    down:       down all tls secrets with config .tls[].down=true
    down -a:    down all tls secrets

"

readonly help_detail="
$help
  attach <container>  Attach stdin, stdout, and stderr to a running container.
  commit [.] <container> [repo]     Create a new image from a container's changes
  compose
  container prune [-f=--force]
  cp [.] <path> <container:path>          Copy files/folders between a running container and the local filesystem.
  cp [.] <container:path> <path>
  diff <container>    Inspect changes to files or directories on a container's filesystem
  export <container>  Export a containers filesystem as a tar archive
  exec [.] <container> <command>  Run a command in a running container
  healthcheck  Execute the health check command in a container
  history <image>
  image inspect [.] <image>    Display detailed information on one or more images.
  image prune [.]     Remove unused images.
      -a=--all: Remove all unused images, not just dangling ones
      -f=--force: Do not prompt for confirmation
  images [repo]           List images
  kill [.] <container>    Kill one or more running containers.
  login -u <username> -p <password> <server>
  logout <server>
  network create|inspect|rm [.] <network>
  network ls|prune [.]
  pause <container> Pause all processes within one or more containers.
  pull <repo>    Pull an image from a registry. Optionally specify \"ipfs://\" or \"ipns://\" scheme to pull image from IPFS.
  push <repo>    Push an image or a repository to a registry. Optionally specify \"ipfs://\" or \"ipns://\" scheme to push image to IPFS.
  rename <old> <new>      rename a container
  restart [.] <container>      Restart one or more running containers
  rm [.] <container>  Remove one or more containers
  rmi [.] <image>     Remove one or more images
  run [.] <image> <command> Run a command in a new container. Optionally specify \"ipfs://\" or \"ipns://\" scheme to pull image from IPFS.
  save [.] <image>        Save one or more images to a tar archive (streamed to STDOUT by default)
  start [.] <container>   Start one or more running containers
  stats [.]     Display a live stream of container(s) resource usage statistics.
  stop [.] <container>    Stop one or more running containers
  system prune [.]  Remove unused containers, images, networks, cache and optional volumes
        -a=--all: Remove all unused images, not just dangling ones
        -f=--force: Do not prompt for confirmation
        --volumes: Prune volumes
  tag <src repo> <target repo>    Create a tag TARGET_IMAGE that refers to SOURCE_IMAGE
  top          Display the running processes of a container
  unpause <container>     Unpause all processes within one or more containers
  update [.] <container>       Update one or more running containers
  volume create|inspect|rm [.] <volume>
  volume ls|prune [.]
  wait <container>    Block until one or more containers stop, then print their exit codes.
  "

declare g_namespace=''
declare g_set_name=''
declare g_selector=''
declare g_container_name=''
declare g_ns_cmd=''

init(){
  InstallOrPanic yq nerdctl >/dev/null

}

valueOf(){
  Usage $# -eq 1 'valueOf <key>'
  local key="$1"
  local value
  value=$(yq -r "$key" "$g_up_yaml")
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    Panic "missing config: $key"
  fi
  printf '%s' "$value"
}

valueOfWithDefault(){
  Usage $# -eq 2 'valueOfWithDefault <key> <default_value>'
  local key="$1"
  local default="$2"
  local value
  value=$(yq -r "$key" "$g_up_yaml")
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    value="$default"
  fi
  printf '%s' "$value"
}

decodeYq(){
  Usage $# -eq 2 'decodeYq <str> <key>'
  local str="$1"
  local key="$2"
  local value
  value=$(echo "$str" | yq -r "$key")
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    Panic "missing config: $key in $str"
  fi
  printf '%s' "$value"
}

decodeYqWithDefault(){
  Usage $# -eq 3 'decodeYqWithDefault <decoded> <key> <default_value>'
  local decoded="$1"
  local key="$2"
  local default="$3"
  local value
  value=$(echo "$decoded" | yq -r "$key")
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    value="$default"
  fi
  printf '%s' "$value"
}

setupDefault(){
  if ! k8sIsWorkdir "$g_workdir"; then
    return 1
  fi
  g_namespace="$(k3sDetectNamespace "$g_workdir" WITH_PANIC)"
  local name
  name=$(basename "$g_workdir")
  g_set_name="deployment/${name}-set"
  g_selector="app=${name}"
  g_container_name="aa-${name}"
  g_ns_cmd="sh"
  Notice "setup default: namespace=>$g_namespace, setName=>$g_set_name, selector=>$g_selector, containerName=>$g_container_name"
  return 0
}

initSetYaml(){
  local set_yaml="$1"
  # find mount dir and create it
  while IFS= read -r volume_base64; do
    local volume
    volume=$(echo "$volume_base64" | base64 -d)
    volume_type=$(decodeYqWithDefault "$volume" '.hostPath.type' '')
    if [ "$volume_type" = 'DirectoryOrCreate' ]; then
      volume_name=$(decodeYq "$volume" '.name')
      volume_path=$(decodeYq "$volume" '.hostPath.path')
      Debug "mkdir and chmod 777 $volume_name => $volume_path"
      ChmodOrMkdir 777 "$volume_path"
    fi
  done < <(yq -r '.spec.template.spec.volumes[] | select(.hostPath != null) | @base64' "$set_yaml" 2>/dev/null | grep -v '^$')
  # k3sBuild 会自动查找image，并下载
}

parseSetYaml(){
  local with_init="${1:-}"
  local set_yaml="$g_workdir/$K8S_SET_YAML"
  if [ ! -f "$set_yaml" ]; then
    return 1
  fi

  if [ "$with_init" = '-init' ]; then
    initSetYaml "$set_yaml"
  fi

  local kind
  kind=$(yq -r '.kind' "$set_yaml" | tr '[:upper:]' '[:lower:]')
  if [ -z "$kind" ] || [ "$kind" = "null" ]; then
    Panic "$set_yaml missing config: .kind"
  fi

  local name
  name=$(yq -r '.metadata.name' "$set_yaml")
  if [ -z "$name" ] || [ "$name" = "null" ]; then
    Panic "$set_yaml missing config: .metadata.name"
  fi

  g_set_name="${kind}/${name}"
}

parseUpYaml(){
  Usage $# -le 2 'parseUpYaml [-optional] [-init]'
  local optional=''
  local with_init=''

  for arg in "$@"; do
    case "$arg" in
      -optional) optional='-optional' ;;
      -init) with_init='-init' ;;
    esac
  done

  parseSetYaml "$with_init"

  if [ ! -f "$g_up_yaml" ]; then
    if setupDefault ; then
      return
    fi

    if [ "$optional" = '-optional' ]; then
      return
    fi
    Panic "missing $g_up_yaml or it's not a valid workdir"
  fi
  g_namespace="$(k3sDetectNamespace "$g_workdir" WITH_PANIC)"
  name=$(valueOfWithDefault '.name' "$(basename "$g_workdir")")
  g_set_name=$(valueOfWithDefault '.setName' "$g_set_name")
  g_selector=$(valueOfWithDefault '.selector' "app=${name}")
  g_container_name=$(valueOfWithDefault '.containerName' "aa-${name}")
  g_ns_cmd=$(valueOfWithDefault '.nsenterCommand' "sh")

  Notice "namespace=>$g_namespace, setName=>$g_set_name, selector=>$g_selector, containerName=>$g_container_name"
}

tlsConfigExists(){
  local tls_value
  tls_value=$(yq -e '.tls' "$g_up_yaml" 2>/dev/null)
  Info "$g_up_yaml"
  if [ -n "$tls_value" ] && [ "$tls_value" != 'null' ]; then
    return 0
  fi
  return 1
}

tlsDown(){
  local all="${1:-}"
  if ! tlsConfigExists; then
    Info "exists"
    return
  fi

  g_temp_file=$(mktemp) || return 1
  trap 'rm -f "$g_temp_file" 2>/dev/null' EXIT
  trap 'rm -f "$g_temp_file" 2>/dev/null; return 1' INT TERM

  if [ "$all" = '-a' ]; then
    yq -r '.tls[] | .secretName' "$g_up_yaml" 2>/dev/null > "$g_temp_file"
  else
    yq -r '.tls[] | select(.down == true) | .secretName' "$g_up_yaml" 2>/dev/null > "$g_temp_file"
  fi

  while read -r secret; do
    [ -n "$secret" ] && k3sDeleteSecret "$g_namespace" "$secret"
  done < "$g_temp_file"

  rm -f "$g_temp_file"
}

tlsUp(){
  if ! tlsConfigExists; then
    return
  fi
  # 转为Json以后，tls={} 存在 {}/[] 等特殊符号，因此需要base64一下
  yq -r '.tls[] | @base64' "$g_up_yaml" | while read -r tls_b64; do
    [ -z "$tls_b64" ] && continue
    tls=$(echo "$tls_b64" | base64 -d)
    secret=$(decodeYq "$tls" '.secretName')
    declare first_host=''
    declare default_san=''
    # host=xx.xx.xx 不存在特殊字符和换行符，不需要base64
    while IFS= read -r host; do
      if [ -z "$first_host" ]; then first_host="$host"; fi
      if [ -n "$default_san" ]; then default_san="${default_san},"; fi

      if IsDomain "$host"; then
        default_san="${default_san}DNS:${host}"
      elif IsIP "$host"; then
        default_san="${default_san}IP:${host}"
      else
        Panic "Invalid host: $host"
      fi
    done <<< "$(echo "$tls" | yq -r '.hosts[]')"

    if [ -z "$first_host" ]; then
      Panic "Missing config tls[].hosts"
    fi

    local create_nx
    local common_name
    local cert_dir
    local san
    local subj
    local privkey_name
    local cert_name
    local expire_days
    create_nx=$(decodeYqWithDefault "$tls" '.createIfNotExists' 'false')
    common_name=$(decodeYqWithDefault "$tls" '.commonName' "$first_host")
    cert_dir=$(decodeYqWithDefault "$tls" '.certDir' "")
    san=$(decodeYqWithDefault "$tls" '.subjectAltName' "$default_san")
    subj=$(decodeYqWithDefault "$tls" '.subj' "/CN=${common_name}")
    privkey_name=$(decodeYqWithDefault "$tls" '.privkeyFile' "$CERT_KEY_FILE")
    cert_name=$(decodeYqWithDefault "$tls" '.certFile' "$CERT_FILE")
    expire_days=$(decodeYqWithDefault "$tls" '.expireDays' "$CERT_EXPIRE_DAYS")

    if [ -z "$cert_dir" ]; then
      cert_dir=$(AbsDir "${g_workdir}/../../aa/cert")
      if [ ! -d "$cert_dir" ]; then
        cert_dir="/etc/cert"
      fi
      cert_dir="$cert_dir/$common_name"
      mkdir -p "$cert_dir"
    fi

    if Yes "$create_nx"; then
        k3sCreateTlsSecret "$g_namespace" "$g_workdir" "$secret" "$common_name" "$cert_dir" "$san" "$subj" "$privkey_name" "$cert_name" "$expire_days"
    fi

    Notice "$common_name => $san"
  done
}

tlsList(){
  if ! tlsConfigExists; then
    return
  fi
  # 转为Json以后，tls={} 存在 {}/[] 等特殊符号，因此需要base64一下
  yq -r '.tls[] | @base64' "$g_up_yaml" 2>/dev/null | while read -r tls_b64; do
    [ -z "$tls_b64" ] && continue
    tls=$(echo "$tls_b64" | base64 -d)
    secret=$(decodeYq "$tls" '.secretName')
    Highlight "${_HORIZONTAL_LINE_}secret: $secret${_HORIZONTAL_LINE}"
    $SUDO kubectl get secret "$secret" -n "$g_namespace" -o json
  done
}

destroy(){
  parseUpYaml
  k3sDestroy "$g_namespace"
}

down(){
  local all="${1:-}"
  parseUpYaml
  tlsDown "$all"
  k3sDown "$g_workdir"
}

execCurl(){
  Usage $# -ge 1 "$g_fn curl [flag] <url>"
  parseUpYaml -optional
  k3sCurl "$@" "$g_namespace"
}


# nerdctl logs 功能还不全，暂时不用支持
logs(){
  Usage $# -le 1 "$g_fn logs [container|pod]"

  parseUpYaml
  if [ "$#" -eq 1 ]; then
    k3sLogs "$g_namespace" "$g_selector" "$g_container_name" "$1"
  else
    k3sLogs "$g_namespace" "$g_selector" "$g_container_name"
  fi
}

nsenter(){
  parseUpYaml
  k3sNsenter "$g_namespace" "$g_selector" "$g_container_name" "$@"
}

pull(){
  if [ $# -gt 0 ]; then
    nerdctl pull "$@"
    return
  fi

  k8sAutoPullImages "$g_workdir"
}

purge(){
  parseUpYaml
  k3sPurge "$g_workdir" "$g_namespace" "$g_set_name" "$g_selector"
}


up(){
  parseUpYaml -init
  tlsUp
  k3sUp "$g_workdir" "$g_selector" "$g_container_name" "$g_namespace"
}

restart(){
  if [ $# -gt 0 ]; then
    nerdctl restart "$@"
    return
  fi
  parseUpYaml
  k3sRestart "$g_namespace" "$g_set_name"
}

status(){
  if [ $# -gt 0 ]; then
    nerdctl status "$@"
    return
  fi

  parseUpYaml
  k3sStatus "$g_namespace" "$g_selector" "$g_container_name"
}


testRun(){
  Usage $# -eq 2 "$g_fn test <image> <interact>"
  local image="$1"
  local interact="$2"

  parseUpYaml -optional
  k3sTestRun "$image" "$interact" "$g_namespace" "$g_ns_cmd"
}



tls(){
  Usage $# -le 1 'secret [command]'
  local cmd="${1:-""}"
  shift 1

  parseUpYaml

  case "$cmd" in
    down) tlsDown "$@";;
    up) tlsUp ;;
    *) tlsList ;;
  esac
}

main(){
  if CanSudo; then
    exec sudo "${BASH_SOURCE[0]}" "$@"       # exec 会替换当前shell进程，后续命令不再执行
  fi

  Usage $# -ge 1 "$help"
  local cmd="$1"
  shift

  init

  case "$cmd" in
    -h|h) Lowlight "$help" ;;
    --help|help) Lowlight "$help_detail" ;;
    curl) execCurl "$@" ;;
    destroy) destroy  ;;
    down) down "$@" ;;
    logs) logs "$@" ;;
    ns|nsenter) nsenter "$@" ;;
    pull) pull "$@" ;;
    purge) purge "$@" ;;
    up) up ;;
    upd|update) down && up ;;
    restart) restart "$@" ;;
    status) status "$@" ;;
    test) testRun "$@" ;;
    tls) tls "$@" ;;
    *) nerdctl "$cmd" "$@" ;;
  esac
}

main "$@"