#!/bin/bash
set -euo pipefail

# https://github.com/aarioai/opt
. /opt/k8s/lib/k8s-lib.sh

g_workdir=$(pwd)
readonly g_workdir
readonly g_up_yaml="$g_workdir/$K8S_UP_YAML"

g_fn=$(basename "$0")

readonly help="
[.]=[options] <repo>=<repository:[tag]>  <image>=<image id>  <container>=<container id>

$g_fn <command> [.]
  -h|h            Show tidy help
  --help|help     Show detailed help

  attach, commit, compose, container prune, cp, diff, export, exec, healthcheck, history,
  image inspect, image prune, images, kill, login, logout, logs, network, pause, pull, push,
  rename, restart, rm, rmi, save, start, stats, stop, system prune, tag, top, unpause, update, volume, wait


  destroy [-y]
    -y:         no confirmation
  down [-a]     down current (delete)
    -a:         down with all tls secrets
  logs [container|pod]
  ns|nsenter
  up [helm args]
  upd|update    update current (down and up)
  upg|upgrade       helm upgrade
  probe <what>
  pull
  purge
  restart
  run
  status
    status [nerdctl args]
  tls [command]
    list:       simple list all tls secrets
    json:       list all tls secrets in json format
    up:         up all tls secrets
    down:       down all tls secrets with config .tls[].down=true
    down -a:    down all tls secrets
    <tls_name>: show this secret
"

readonly help_detail="
$help
  attach <container>  Attach stdin, stdout, and stderr to a running container.
  commit [.] <container> [repo]     Create a new image from a container's changes
  compose
  container prune [-f=--force]
  cp [.] <path> <container:path>          Copy files/folders between a running container and the local filesystem.
  cp [.] <container:path> <path>
  diff <container>    Inspect changes to files or directories on a container's filesystem
  export <container>  Export a containers filesystem as a tar archive
  exec [.] <container> <command>  Run a command in a running container
  healthcheck  Execute the health check command in a container
  history <image>
  image inspect [.] <image>    Display detailed information on one or more images.
  image prune [.]     Remove unused images.
      -a=--all: Remove all unused images, not just dangling ones
      -f=--force: Do not prompt for confirmation
  images [repo]           List images
  kill [.] <container>    Kill one or more running containers.
  login -u <username> -p <password> <server>
  logout <server>
  network create|inspect|rm [.] <network>
  network ls|prune [.]
  pause <container> Pause all processes within one or more containers.
  pull <repo>    Pull an image from a registry. Optionally specify \"ipfs://\" or \"ipns://\" scheme to pull image from IPFS.
  push <repo>    Push an image or a repository to a registry. Optionally specify \"ipfs://\" or \"ipns://\" scheme to push image to IPFS.
  rename <old> <new>      rename a container
  restart [.] <container>      Restart one or more running containers
  rm [.] <container>  Remove one or more containers
  rmi [.] <image>     Remove one or more images
  run [.] <image> <command> Run a command in a new container. Optionally specify \"ipfs://\" or \"ipns://\" scheme to pull image from IPFS.
  save [.] <image>        Save one or more images to a tar archive (streamed to STDOUT by default)
  start [.] <container>   Start one or more running containers
  stats [.]     Display a live stream of container(s) resource usage statistics.
  stop [.] <container>    Stop one or more running containers
  system prune [.]  Remove unused containers, images, networks, cache and optional volumes
        -a=--all: Remove all unused images, not just dangling ones
        -f=--force: Do not prompt for confirmation
        --volumes: Prune volumes
  tag <src repo> <target repo>    Create a tag TARGET_IMAGE that refers to SOURCE_IMAGE
  top          Display the running processes of a container
  unpause <container>     Unpause all processes within one or more containers
  update [.] <container>       Update one or more running containers
  volume create|inspect|rm [.] <volume>
  volume ls|prune [.]
  wait <container>    Block until one or more containers stop, then print their exit codes.
  "

pull(){
  if [ $# -gt 0 ]; then
    $SUDO nerdctl pull "$@"
    return
  fi
  k8sPullProbedImages "$g_workdir"
}

restart(){
  if [ $# -gt 0 ]; then
    $SUDO nerdctl restart "$@"
    return
  fi

  k8sRestartHere "$g_workdir"
}

status(){
  if [ $# -gt 0 ]; then
    $SUDO nerdctl status "$@"
    return
  fi
  k8sProbe status
}

tls(){
  local cmd="${1:-""}"
  case "$cmd" in
    down) shift; k8sDownTLS "$g_workdir" "$@" ;;
    up) shift; k8sUpTLS "$g_workdir" "$@" ;;
    *) k8sProbe tls "$@" ;;
  esac
}

main(){
  if CanSudo; then
    exec sudo "${BASH_SOURCE[0]}" "$@"       # exec 会替换当前shell进程，后续命令不再执行
  fi

  Usage $# -ge 1 "$help"
  local cmd="$1"
  shift

  case "$cmd" in
    -h|h) Lowlight "$help" ;;
    --help|help) Lowlight "$help_detail" ;;
    destroy) k8sDestroyHere "$g_workdir" "$@";;
    down) k8sDown "$g_workdir"  "$@" ;;
    logs) k8sProbeLogs "$g_workdir" "$@" ;;
    ns|nsenter) k8sNsenterHere "$g_workdir" "$@" ;;
    probe) k8sProbe "$@" ;;
    pull) pull "$@" ;;
    up) k8sUp "$g_workdir" "$@";;
    upd|update) k8sDown "$g_workdir"  "$@" && k8sUp "$g_workdir" "$@" ;;
    restart) restart "$@" ;;
    status) status "$@" ;;
    tls) tls "$@" ;;
    *) nerdctl "$cmd" "$@" ;;
  esac
}

main "$@"